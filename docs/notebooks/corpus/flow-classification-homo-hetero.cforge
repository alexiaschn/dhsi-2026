        "dragging": false
      },
      {
        "width": 348,
        "height": 226,
        "id": "evalNode-a73df8f5-5672-4aad-9bf2-7316689af764",
        "type": "evaluator",
        "data": {
          "language": "python",
          "code": "import re\ndef evaluate(response):\n  def parse(text):\n    if re.search(r'h[eé]t[ée]ro', text ):\n      return 'hetero'\n    elif re.search(r'homo', text):\n      return 'homo'\n    else:\n      return 'error parsing'\n      \n      \n    \n  parsed_response = parse(response.text.lower())\n  \n  return response.meta['type'] == parsed_response",
