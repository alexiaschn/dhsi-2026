            },
            {
              "header": "author_fr",
              "key": "c4"
            },
            {
              "header": "text_fr",
              "key": "c5"
            },
            {
              "header": "type",
              "key": "c6"
            }
          ],
          "sel_rows": null
        },
        "position": {
          "x": -304,
          "y": 160
        },
        "selected": false,
        "positionAbsolute": {
          "x": -304,
